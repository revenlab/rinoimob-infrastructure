# Copy to .env.prod on the production host. Do not commit real secrets.

# Public DNS
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
WEBSITE_DOMAIN=www.example.com
FILES_DOMAIN=files.example.com

# Cloudflare
# Use proxied DNS records and SSL/TLS mode Full (strict).
# Mount the Cloudflare Origin Certificate files at:
#   ./certs/cloudflare-origin.pem
#   ./certs/cloudflare-origin.key

# Backend runtime
SPRING_PROFILE=prod
SERVER_PORT=39000
SERVER_ADDRESS=0.0.0.0
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
PUBLIC_CORS_ALLOWED_ORIGINS=https://*
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_ACCESS_TOKEN_EXPIRATION=28800000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Cloudflare for SaaS / Custom Hostnames
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CUSTOM_HOSTNAME_TARGET=www.example.com

# Initial internal support operator created by ProdDataSeeder
SUPPORT_ADMIN_EMAIL=suporte@example.com
SUPPORT_ADMIN_PASSWORD=replace-with-strong-initial-password

# PostgreSQL
DB_NAME=rinoimob
DB_USER=rinoimob
DB_PASSWORD=replace-with-strong-db-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=rinoimob
RABBITMQ_PASSWORD=replace-with-strong-rabbitmq-password

# SeaweedFS
SEAWEEDFS_VOLUME_PUBLIC_URL=https://files.example.com

# Evolution API
EVOLUTION_API_KEY=replace-with-strong-evolution-api-key
EVOLUTION_API_EXTERNAL_URL=http://evolution-api:8080

# App build-time public URLs
APP_VITE_API_URL=https://api.example.com
APP_VITE_WS_URL=https://api.example.com/ws

# Website runtime
NUXT_PUBLIC_API_URL=https://api.example.com
NUXT_PUBLIC_APP_URL=https://app.example.com
NUXT_API_INTERNAL_URL=http://backend:39000

# Email
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=replace-with-mail-secret

# AI / billing providers. Leave blank only if the feature is intentionally disabled.
AI_PROVIDER=gemini
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_WEBHOOK_SIGNING_SECRET=
ABACATEPAY_PRODUCT_STARTER_ID=
ABACATEPAY_PRODUCT_PRIME_ID=
ABACATEPAY_PRODUCT_ULTIMATE_ID=
